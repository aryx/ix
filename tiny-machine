#
# tiny-machine: a kernel and its programs, assembled, linked and run on
# tiny-machine (tiny/TinyMachine.ml), as mini-pi boots the Pi's kernels
# on mini-qemu; by default TinyKernel v0 and its four programs
# (tiny/tiny-os/, whose Makefile does the same with the installed tools).
#
#   ./tiny-machine                          tiny/tiny-os/kernel.tm and
#                                           tiny/tiny-os/[abcd].tm
#   ./tiny-machine kernel.tm prog.tm...     a kernel of yours (first) and
#                                           its programs
#
# Options:
#   -l   the listing of the image instead of running it
#   -n   no build (use tiny-machine as last built)
#
# The image, the memory's first bytes as the machine starts, is kept in
# _build/default/tiny/kernel.img; `bin/tiny-machine kernel.img` runs it
# again. This script is not installed: bin/tiny-machine is the machine
# itself, which does each step (-o to link, an image to run).

set -e
ROOT=$(dirname "$(readlink -f "$0")")
listing=0; build=1

usage() { sed -n '/^# tiny-machine:/,/^# itself, /p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

while getopts lnh o; do
  case $o in l) listing=1;; n) build=0;; *) usage;; esac
done
shift $((OPTIND - 1))

if [ $# = 0 ]; then
  set -- $ROOT/tiny/tiny-os/kernel.tm $ROOT/tiny/tiny-os/[abcd].tm
fi
for f in "$@"; do [ -f "$f" ] || { echo "tiny-machine: no $f" >&2; exit 1; }; done

if [ $build = 1 ]; then
  (cd $ROOT && dune build ./tiny/TinyMachine.exe 2>&1) || exit 1
fi
machine=$ROOT/_build/default/tiny/TinyMachine.exe
image=$ROOT/_build/default/tiny/kernel.img

# what is done, on standard error (the console's output stays clean)
say() { echo "tiny-machine: $*" >&2; }
short() { local f; for f in "$@"; do f=$(readlink -f "$f"); echo -n "${f#$ROOT/} "; done; }
say "assemble and link: $(short $1)(the kernel, at 0)$( [ $# -gt 1 ] && echo ", then $(short "${@:2}")")"
$machine -o $image "$@"
say "image: $(short $image)($(stat -c %s $image) bytes)"
if [ $listing = 1 ]; then exec $machine -l $image; fi
say "run:   $(short $machine $image)"
exec $machine $image
