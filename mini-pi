# mini-pi: boot a Raspberry Pi kernel under mini-qemu (raspberry/,
# mini-qemu) without its long command line: the kernel, its image, the
# options its own Makefile gives QEMU.
#
#   ./mini-pi xv6            xv6 arm-pi1-bis, the console in this terminal
#   ./mini-pi xv6-pi1        xv6 arm-pi1
#   ./mini-pi xv6-pi4        xv6 arm64-pi4, the Pi4 (one core; -c 4 its four)
#   ./mini-pi 9pi            principia's 9pi, its SD card image, the console
#                       in this terminal (the mini UART)
#   ./mini-pi mini-xv6-pi1   ix's mini-xv6 (kernel/xv6/: xv6 in OCaml) on the
#                       Pi1, with xv6 arm-pi1's fs.img; built first
#   ./mini-pi mini-xv6-pi4   the same kernel on the Pi4, with xv6
#                       arm64-pi4's fs.img (one core); -g for both: its
#                       console drawn in a window, a USB keyboard and mouse
#   ./mini-pi mini-9pi       ix's mini-9pi (kernel/9pi/: 9pi in OCaml) on the
#                       Pi1, principia's SD card image, to rc's prompt;
#                       built first; -g: its console drawn in a window as
#                       9pi draws it, a USB keyboard and mouse: type rio
#                       there (the draw device, Devdraw.ml)
#
# Options:
#   -g   a window: the framebuffer (and for xv6, a USB keyboard: type in
#        the window or in the terminal; for 9pi, a USB keyboard and
#        mouse: the draw console, rio from it; a click grabs the mouse,
#        Ctrl-Alt-G releases it)
#   -w   9pi, mini-9pi: write to the SD card image (by default its writes are kept
#        in memory and lost at exit, QEMU's snapshot=on)
#   -q   run QEMU instead, with the same arguments (to compare)
#   -d   mini-qemu's log of unassigned I/O and undefined instructions
#   -n   no build (use mini-qemu, and mini-xv6 or mini-9pi, as last built)
#   -c N xv6-pi4: N cores (1 to 4, default 1; xv6's idle cores spin, so
#        each one more slows it down)
#
# Quit with Ctrl-A then x (or close the window).
#
# Where the kernels are: $XV6 (default ~/xv6: xv6-multiarch, its ports
# built), $PRINCIPIA (default ~/principia: 9pi built, qemu-sd.img),
# mini-xv6 in ix's kernel/xv6/ (with $XV6's arm-pi1 and arm64-pi4 fs.img),
# mini-9pi in ix's kernel/9pi/ (with $PRINCIPIA's bootdir and qemu-sd.img).

set -e
# claude: ix's checkout, also when run as bin/mini-pi (a link into
# _build/default/, where dune copies the script); installed elsewhere
# (dune install), it needs $IX, the checkout
ROOT=$(dirname "$(readlink -f "$0")")
case $ROOT in */_build/default) ROOT=${ROOT%/_build/default};; esac
ROOT=${IX:-$ROOT}
[ -d "$ROOT/raspberry" ] || { echo "mini-pi: $ROOT is not ix's checkout (set IX)" >&2; exit 2; }
XV6=${XV6:-$HOME/xv6}
PRINCIPIA=${PRINCIPIA:-$HOME/principia}
graphics=0; write=0; qemu=0; debug=0; build=1; cores=1

usage() { sed -n '/^# mini-pi:/,/^# mini-xv6 in ix/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

while getopts gwqdnc:h o; do
  case $o in
    g) graphics=1;; w) write=1;; q) qemu=1;; d) debug=1;; n) build=0;; c) cores=$OPTARG;; *) usage;;
  esac
done
shift $((OPTIND - 1))
[ $# = 1 ] || usage

case $1 in
  xv6|xv6-pi1)
    port=arm-pi1-bis; image=kernel.img
    [ $1 = xv6-pi1 ] && { port=arm-pi1; image=kernel-qemu.img; }
    dir=$XV6/forks/$port
    args=(-M raspi1ap -kernel $image)
    if [ $graphics = 1 ]; then args+=(-serial mon:stdio -device usb-kbd); else args+=(-nographic); fi
    ;;
  xv6-pi4)
    dir=$XV6/forks/arm64-pi4; image=kernel/kernel
    [ $graphics = 1 ] && { echo "mini-pi: xv6-pi4 has no graphics"; exit 1; }
    # QEMU's raspi4b wants its four cores
    smp=$cores; [ $qemu = 1 ] && smp=4
    args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp -nographic)
    ;;
  mini-xv6-pi1|mini-xv6-pi4)
    board=${1#mini-xv6-}
    dir=$ROOT/kernel/xv6
    if [ $build = 1 ]; then
      arch=arm; [ $board = pi4 ] && arch=arm64
      $ROOT/kernel/ocaml-light.sh $arch > /dev/null && make -C $dir BOARD=$board XV6=$XV6 > /dev/null || { echo "mini-pi: mini-xv6 not built"; exit 1; }
    fi
    # -g: a window, its framebuffer console (Screen.ml: the console's
    # output drawn), a USB keyboard and mouse (Usbhost.ml: type in the
    # window or the terminal; the mouse moves the screen's cursor)
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    if [ $board = pi1 ]; then
      image=kernel-pi1.img
      args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on "${display[@]}")
    else
      image=kernel-pi4.elf
      smp=1; [ $qemu = 1 ] && smp=4
      args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp "${display[@]}")
    fi
    ;;
  mini-9pi)
    dir=$ROOT/kernel/9pi
    [ -f $PRINCIPIA/qemu-sd.img ] || { echo "mini-pi: no $PRINCIPIA/qemu-sd.img (principia: mk disk)"; exit 1; }
    if [ $build = 1 ]; then
      $ROOT/kernel/ocaml-light.sh arm > /dev/null && make -C $dir PRINCIPIA=$PRINCIPIA > /dev/null || { echo "mini-pi: mini-9pi not built"; exit 1; }
    fi
    image=kernel-pi1.img
    snapshot=",snapshot=on"; [ $write = 1 ] && snapshot=""
    # its console the PL011 (kernel/lib's), in this terminal; -g: also
    # drawn in a window (Swconsole.ml), a USB keyboard (usbd's usb/kb:
    # type in the window) and mouse (the arrow cursor, Swcursor.ml)
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on
          -drive file=$PRINCIPIA/qemu-sd.img,if=sd,format=raw$snapshot "${display[@]}")
    ;;
  9pi)
    dir=$PRINCIPIA
    image=kernel/COMPILE/9/bcm/9pi
    snapshot=",snapshot=on"; [ $write = 1 ] && snapshot=""
    [ -f $dir/qemu-sd.img ] || { echo "mini-pi: no $dir/qemu-sd.img (principia: mk disk)"; exit 1; }
    args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on
          -drive file=qemu-sd.img,if=sd,format=raw$snapshot -serial null -serial mon:stdio)
    # graphics as principia's "mk run": the draw console, a USB keyboard
    # and mouse (rio from it; a click in the window grabs the mouse,
    # Ctrl-Alt-G lets it go)
    if [ $graphics = 1 ]; then args+=(-device usb-kbd -device usb-mouse); else args+=(-display none); fi
    ;;
  *) usage;;
esac
[ -f $dir/$image ] || { echo "mini-pi: no $dir/$image (build the kernel first)"; exit 1; }

# what is used, on standard error (the console's output stays clean)
emulator=$ROOT/_build/default/raspberry/Main.exe
QEMU64=${QEMU64:-/media/pad/extradrive1/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64}
[ -x $QEMU64 ] || QEMU64=$(command -v qemu-system-aarch64)
qemu_exe=$(command -v qemu-system-arm); case $1 in xv6-pi4|mini-xv6-pi4) qemu_exe=$QEMU64;; esac
[ $qemu = 1 ] && emulator=$qemu_exe
say() { echo "mini-pi: $*" >&2; }
say "emulator: $emulator$( [ $qemu = 0 ] && echo " (mini-qemu)")"
say "kernel:   $dir/$image ($(stat -c %s $dir/$image) bytes, built $(date -r $dir/$image '+%Y-%m-%d %H:%M'))"
if [ $1 = 9pi ] || [ $1 = mini-9pi ]; then
  if [ $write = 1 ]; then mode="written in place"; else mode="read-only: writes kept in memory, lost at exit (-w to keep them)"; fi
  say "SD card:  $PRINCIPIA/qemu-sd.img ($(( $(stat -c %s $PRINCIPIA/qemu-sd.img) / 1024 / 1024 )) MB, $mode)"
  if [ $1 = 9pi ]; then say "console:  the mini UART (serial 1)"; else say "console:  the PL011 (serial 0)"; fi
else
  say "disk:     the file system is inside the kernel image (xv6's ramdisk)"
  say "console:  the PL011 (serial 0)"
  [ $1 = xv6-pi4 ] && [ $qemu = 0 ] && say "cores:    $cores of the Pi4's four (-smp $cores); the boot takes about $((20 * cores))s (kinit fills 128MB)"
fi
[ $graphics = 1 ] && case $1 in
  mini-xv6-*|mini-9pi) say "display:  a window, the console drawn there, a USB keyboard and mouse (a click grabs it, Ctrl-Alt-G lets it go)";;
  *) say "display:  a window, and a USB keyboard$( [ $1 = 9pi ] && echo ' and mouse (a click grabs it, Ctrl-Alt-G lets it go)')";;
esac
say "command:  (cd $dir && $emulator ${args[*]})"
say "quit:     Ctrl-A then x$( [ $graphics = 1 ] && echo ', or close the window')"

if [ $qemu = 1 ]; then
  cd $dir && exec $qemu_exe "${args[@]}"
fi
if [ $build = 1 ]; then
  (cd $ROOT && dune build --profile release ./raspberry/Main.exe 2>&1) || exit 1
fi
[ $debug = 1 ] && args+=(-d)
cd $dir && exec $ROOT/_build/default/raspberry/Main.exe "${args[@]}"
